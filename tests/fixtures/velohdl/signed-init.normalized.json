{
  "format": "velohdl.normalized.v1",
  "signals": [
    { "name": "clk", "width": 1 },
    { "name": "rst_n", "width": 1 },
    { "name": "count", "width": 8, "signed": true }
  ],
  "processes": [
    {
      "kind": "always_ff",
      "event": { "edge": "posedge", "signal": "clk" },
      "body": {
        "kind": "if",
        "condition": { "kind": "not", "operand": { "kind": "ref", "name": "rst_n" } },
        "then": { "kind": "nba", "target": "count", "value": { "kind": "const", "value": -1 } },
        "else": {
          "kind": "nba",
          "target": "count",
          "value": {
            "kind": "ite",
            "condition": {
              "kind": "lt", "width": 8, "signed": true,
              "lhs": { "kind": "ref", "name": "count" },
              "rhs": { "kind": "const", "value": 0 }
            },
            "then": { "kind": "neg", "operand": { "kind": "ref", "name": "count" } },
            "else": {
              "kind": "sub",
              "lhs": { "kind": "ref", "name": "count" },
              "rhs": { "kind": "const", "value": 1 }
            }
          }
        }
      }
    }
  ],
  "initial": [
    { "target": "count", "value": { "kind": "const", "value": -1 } }
  ]
}
